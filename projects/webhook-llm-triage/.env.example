# Copie para .env e preencha localmente. Nunca versione o .env.
# Segredo compartilhado com quem envia o webhook (mínimo 16 caracteres).
WEBHOOK_SECRET=troque-por-um-segredo-local-longo
DB_PATH=data/triage.sqlite3

# fake = regras determinísticas (padrão, sem rede). openai = API compatível com OpenAI.
LLM_PROVIDER=fake
# OpenAI: https://api.openai.com/v1  |  Ollama local: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=20

MAX_ATTEMPTS=5
BACKOFF_BASE_S=2
BACKOFF_MAX_S=300
WORKER_ENABLED=true
WORKER_POLL_S=1

# Pasta para CSVs no formato de entrada do rpa-pedidos (vazio = desativado).
RPA_HANDOFF_DIR=
